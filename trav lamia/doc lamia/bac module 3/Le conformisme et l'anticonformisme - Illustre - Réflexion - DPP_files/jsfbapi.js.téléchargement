function streamPublish(message, name, caption, description, hrefTitle, hrefLink){

    FB.ui(
    {
        method: 'stream.publish',
        message: message,
        attachment: {
            name: name,
            caption: caption,
            description: (description),
            href: hrefLink
        },
        action_links: [
            {
                text: hrefTitle,
                href: hrefLink
            }
        ],
        user_prompt_message: "De Plume en Plume"
    },
    function(response) {

    });
}

